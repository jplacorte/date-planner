# ==========================================
# App access (REQUIRED in production)
# ==========================================
# A shared passcode guards every API route. Without it, anyone who finds the
# deployed URL could read, overwrite, or upload into your Google Drive folder.
#
# The production build refuses to serve the API without this set, so an
# unprotected deployment cannot happen by accident. In local development it is
# optional: leave it blank and the passcode screen is skipped.
#
# Minimum 8 characters. Generate one with:  openssl rand -base64 18
APP_PASSCODE=""

# Signing key for the session cookie. Optional: if omitted it is derived from
# APP_PASSCODE. Set it explicitly to rotate sessions without changing the
# passcode, or to invalidate every signed-in device.
# Minimum 32 characters. Generate one with:  openssl rand -hex 32
AUTH_SECRET=""

# ==========================================
# Google Drive storage
# ==========================================
# The folder that holds uploaded photos and the synced dates_database.json.
# 1. Create a folder in Google Drive (e.g. "Date Checklist Photos")
# 2. Copy the ID segment from its URL:
#    https://drive.google.com/drive/folders/<THIS PART>
GOOGLE_DRIVE_FOLDER_ID=""

# ------------------------------------------
# Option A: OAuth2 user credentials (recommended)
# ------------------------------------------
# Uses your personal Drive storage quota, so uploads and sync both work.
# Run `pnpm auth:drive <client-id> <client-secret>` to fill these in:
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""

# ------------------------------------------
# Option B: Service account (fallback)
# ------------------------------------------
# Service accounts have no storage quota of their own, so creating new files
# fails unless the folder lives on a Shared Drive. Prefer Option A.
# 1. Google Cloud Console -> enable the Google Drive API
# 2. Credentials -> Create Service Account -> generate a JSON key
# 3. Share the Drive folder with the service account email (Editor access)
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
